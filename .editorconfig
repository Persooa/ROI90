# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

# JavaScript / TypeScript
[*.{js,jsx,ts,tsx}]
indent_size = 2
quote_type = single
semi = false

# JSON / configi
[*.{json,jsonc,yml,yaml}]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# CSS / SCSS
[*.{css,scss}]
indent_size = 2

# HTML
[*.html]
indent_size = 2

# Shell scripts
[*.sh]
indent_size = 2

# Makefile wymaga tabów
[Makefile]
indent_style = tab